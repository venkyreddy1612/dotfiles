
* {
    bg:           #1a1b26;
    bg-alt:       #24283b;
    fg:           #c0caf5;
    muted:        #565f89;
    blue:         #7aa2f7;
    cyan:         #7dcfff;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 520px;
    border: 2px;
    border-color: @blue;
    border-radius: 12px;
    background-color: #1a1b26E6;
    padding: 18px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @blue;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @muted;
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    scrollbar: false;
    spacing: 5px;
    background-color: transparent;
}

element {
    padding: 10px;
    border-radius: 7px;
    background-color: transparent;
}

element selected {
    background-color: @bg-alt;
    text-color: @cyan;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    background-color: transparent;
    size: 28px;
    margin: 0 10px 0 0;
}

